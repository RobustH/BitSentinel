BITSENTINEL_APP_NAME=BitSentinel API
BITSENTINEL_ENVIRONMENT=local
BITSENTINEL_API_PREFIX=/api
BITSENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176

# Database connections are configured only on the backend. Do not expose this value in frontend code.
BITSENTINEL_DATABASE_URL=postgresql+psycopg://bitsentinel:bitsentinel@postgres:5432/bitsentinel
BITSENTINEL_REDIS_URL=redis://redis:6379/0

BITSENTINEL_BINANCE_SPOT_BASE_URL=https://api.binance.com
BITSENTINEL_BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BITSENTINEL_BINANCE_WS_BASE_URL=wss://stream.binance.com:9443

BITSENTINEL_EMAIL_ENABLED=false
BITSENTINEL_SMTP_HOST=
BITSENTINEL_SMTP_PORT=587
BITSENTINEL_SMTP_USERNAME=
BITSENTINEL_SMTP_PASSWORD=
BITSENTINEL_ALERT_FROM_EMAIL=
BITSENTINEL_ALERT_TO_EMAIL=
